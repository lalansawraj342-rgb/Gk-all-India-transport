{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered customer profile with mobile number, address, contact details, and language preference.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the user." },
        "name": { "type": "string", "description": "Customer full name." },
        "mobileNumber": { "type": "string", "description": "Customer 10-digit or +91 mobile number." },
        "email": { "type": "string", "description": "Customer email address from Google Sign-In." },
        "city": { "type": "string", "description": "Customer home city." },
        "address": { "type": "string", "description": "Customer full street/business address." },
        "alternatePhone": { "type": "string", "description": "Optional alternate contact number." },
        "preferredLanguage": { "type": "string", "enum": ["en", "hi"], "description": "UI language preference." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update." }
      },
      "required": ["userId", "name", "mobileNumber", "preferredLanguage", "createdAt", "updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized G.K. All Transport administrator record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "addedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "addedBy", "createdAt"]
    },
    "FleetVehicle": {
      "title": "FleetVehicle",
      "description": "Company transport vehicle registered in fleet.",
      "type": "object",
      "properties": {
        "vehicleNumber": { "type": "string" },
        "vehicleType": {
          "type": "string",
          "enum": [
            "Tata Ace", "Pickup Truck", "Bolero Pickup", "407 Truck", "709 Truck",
            "1109 Truck", "14 Wheeler Truck", "16 Wheeler Truck", "18 Wheeler Truck",
            "Container Truck", "Trailer Truck", "Dumper", "Other Commercial Vehicles"
          ]
        },
        "driverName": { "type": "string" },
        "driverPhone": { "type": "string" },
        "availability": { "type": "string", "enum": ["Available", "On Trip", "Maintenance"] },
        "currentCity": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["vehicleNumber", "vehicleType", "driverName", "driverPhone", "availability", "createdAt", "updatedAt"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Driver profile with driving licence, assigned vehicle, availability, and trip status.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "licenseNumber": { "type": "string" },
        "assignedVehicleId": { "type": "string" },
        "assignedVehicleNumber": { "type": "string" },
        "availability": { "type": "string", "enum": ["Available", "On Trip", "Off Duty"] },
        "tripStatus": { "type": "string", "enum": ["Idle", "En Route to Pickup", "Loading", "In Transit", "Completed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "mobileNumber", "licenseNumber", "availability", "tripStatus", "createdAt", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Goods vehicle booking submitted by a customer and managed by Admin.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "bookingCode": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "pickupLocation": { "type": "string" },
        "deliveryLocation": { "type": "string" },
        "bookingDateTimeMillis": { "type": "integer" },
        "bookingDateLabel": { "type": "string" },
        "bookingTimeLabel": { "type": "string" },
        "vehicleType": { "type": "string" },
        "goodsDescription": { "type": "string" },
        "goodsWeight": { "type": "string" },
        "goodsPhotos": { "type": "array", "items": { "type": "string" } },
        "specialInstructions": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "Pending", "Accepted", "Vehicle Assigned", "Driver Assigned",
            "On The Way", "Goods Picked Up", "In Transit", "Delivered", "Cancelled"
          ]
        },
        "assignedVehicleId": { "type": "string" },
        "assignedVehicleNumber": { "type": "string" },
        "assignedDriverId": { "type": "string" },
        "assignedDriverName": { "type": "string" },
        "assignedDriverPhone": { "type": "string" },
        "adminNotes": { "type": "string" },
        "estimatedFare": { "type": "string" },
        "totalFareAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["Unpaid", "Advance Paid", "Paid"] },
        "paymentMethod": { "type": "string", "enum": ["None", "Cash", "UPI", "Online", "Advance"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "bookingCode", "customerName", "customerPhone",
        "pickupLocation", "deliveryLocation", "bookingDateTimeMillis",
        "bookingDateLabel", "bookingTimeLabel", "vehicleType",
        "goodsDescription", "goodsWeight", "status", "paymentStatus", "createdAt", "updatedAt"
      ]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Payment transaction for a booking (Cash, UPI, Online, or Advance).",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string" },
        "bookingCode": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["Cash", "UPI", "Online", "Advance"] },
        "status": { "type": "string", "enum": ["Pending Verification", "Paid", "Rejected"] },
        "referenceId": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bookingId", "bookingCode", "userId", "customerName", "amount", "method", "status", "createdAt", "updatedAt"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "In-app and push notification record for booking events and admin messages.",
      "type": "object",
      "properties": {
        "recipientUserId": { "type": "string" },
        "senderUserId": { "type": "string" },
        "bookingId": { "type": "string" },
        "bookingCode": { "type": "string" },
        "type": { "type": "string", "enum": ["BOOKING_REQUEST", "BOOKING_ACCEPTED", "VEHICLE_ASSIGNED", "DELIVERY_COMPLETED", "ADMIN_MESSAGE"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientUserId", "senderUserId", "type", "title", "message", "isRead", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Customer profile records isolated by userId, readable by Admin for customer management."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized admin role registry."
    },
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/FleetVehicle" },
      "description": "Transport fleet vehicles managed by admins."
    },
    "/drivers/{driverId}": {
      "schema": { "$ref": "#/entities/Driver" },
      "description": "Transport drivers managed by admins."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Customer goods transport bookings reviewed and fulfilled by admins."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Customer and admin payment history records."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "Real-time booking and admin notifications."
    }
  }
}
