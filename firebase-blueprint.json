{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered customer profile with verified mobile number and language preference.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the user." },
        "name": { "type": "string", "description": "Customer full name." },
        "mobileNumber": { "type": "string", "description": "Customer 10-digit or +91 mobile number." },
        "email": { "type": "string", "description": "Customer email address from Google Sign-In." },
        "city": { "type": "string", "description": "Customer home city." },
        "preferredLanguage": { "type": "string", "enum": ["en", "hi"], "description": "UI language preference." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation (FieldValue.serverTimestamp())." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update (FieldValue.serverTimestamp())." }
      },
      "required": ["userId", "name", "mobileNumber", "preferredLanguage", "createdAt", "updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized G.K. All India Transport administrator record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID of the admin." },
        "email": { "type": "string", "description": "Admin Google account email." },
        "name": { "type": "string", "description": "Admin display name." },
        "addedBy": { "type": "string", "description": "UID of admin who granted access." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." }
      },
      "required": ["uid", "email", "name", "addedBy", "createdAt"]
    },
    "FleetVehicle": {
      "title": "FleetVehicle",
      "description": "Company transport vehicle and driver available for booking assignment.",
      "type": "object",
      "properties": {
        "vehicleNumber": { "type": "string", "description": "Registration plate number (e.g., MH-12-TR-4590)." },
        "vehicleType": {
          "type": "string",
          "enum": [
            "Tata Ace", "Pickup", "Tata 407", "6 Wheeler", "10 Wheeler",
            "12 Wheeler", "14 Wheeler", "16 Wheeler", "18 Wheeler", "22 Wheeler",
            "Container", "Trailer", "Dumper", "All types of goods vehicles"
          ],
          "description": "Goods vehicle category."
        },
        "driverName": { "type": "string", "description": "Assigned driver full name." },
        "driverPhone": { "type": "string", "description": "Assigned driver contact number." },
        "availability": { "type": "string", "enum": ["Available", "On Trip", "Maintenance"], "description": "Current vehicle availability." },
        "currentCity": { "type": "string", "description": "Current hub or city location." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." }
      },
      "required": ["vehicleNumber", "vehicleType", "driverName", "driverPhone", "availability", "createdAt", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Goods vehicle booking submitted by a customer and managed by Admin.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the customer who placed the booking." },
        "bookingCode": { "type": "string", "description": "Human-readable booking reference code." },
        "customerName": { "type": "string", "description": "Customer full name." },
        "customerPhone": { "type": "string", "description": "Customer mobile number." },
        "pickupLocation": { "type": "string", "description": "Origin pickup city and address." },
        "deliveryLocation": { "type": "string", "description": "Destination delivery city and address." },
        "bookingDateTimeMillis": { "type": "integer", "description": "Scheduled pickup date and time in epoch milliseconds." },
        "bookingDateLabel": { "type": "string", "description": "Formatted pickup date string." },
        "bookingTimeLabel": { "type": "string", "description": "Formatted pickup time string." },
        "vehicleType": {
          "type": "string",
          "enum": [
            "Tata Ace", "Pickup", "Tata 407", "6 Wheeler", "10 Wheeler",
            "12 Wheeler", "14 Wheeler", "16 Wheeler", "18 Wheeler", "22 Wheeler",
            "Container", "Trailer", "Dumper", "All types of goods vehicles"
          ],
          "description": "Requested goods vehicle type."
        },
        "goodsDescription": { "type": "string", "description": "Description of cargo/goods to transport." },
        "goodsWeight": { "type": "string", "description": "Approximate weight with unit (e.g., 12 Tons)." },
        "specialInstructions": { "type": "string", "description": "Optional special handling or loading instructions." },
        "status": {
          "type": "string",
          "enum": [
            "New Booking", "Pending", "Confirmed", "Vehicle Assigned",
            "Vehicle Dispatched", "Delivered", "Cancelled"
          ],
          "description": "Lifecycle status of the booking. Must start as New Booking."
        },
        "assignedVehicleId": { "type": "string", "description": "Document ID of assigned FleetVehicle." },
        "assignedVehicleNumber": { "type": "string", "description": "Registration number of assigned vehicle." },
        "assignedDriverName": { "type": "string", "description": "Driver name assigned by Admin." },
        "assignedDriverPhone": { "type": "string", "description": "Driver mobile number assigned by Admin." },
        "adminNotes": { "type": "string", "description": "Optional remarks from Admin." },
        "estimatedFare": { "type": "string", "description": "Optional fare quote provided by Admin." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." }
      },
      "required": [
        "userId", "bookingCode", "customerName", "customerPhone",
        "pickupLocation", "deliveryLocation", "bookingDateTimeMillis",
        "bookingDateLabel", "bookingTimeLabel", "vehicleType",
        "goodsDescription", "goodsWeight", "status", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Customer profile records isolated by userId."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized admin role registry."
    },
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/FleetVehicle" },
      "description": "Transport fleet vehicles managed by admins."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Customer goods transport bookings reviewed and fulfilled by admins."
    }
  }
}
